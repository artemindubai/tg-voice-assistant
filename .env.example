BOT_TOKEN=            # the Telegram bot that opens the Mini App (used to verify initData)
OWNER_TG_ID=          # your Telegram user id; everyone else gets 403
OPENAI_API_KEY=
API_TOKEN=            # random string for your backend: POST /api/notes, GET /api/transcripts
ASSISTANT_NAME=Assistant
LANGUAGE=en           # transcription language
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin
ASSISTANT_PROMPT=     # optional: replaces the default instructions
DATA_DIR=./data
